generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int        @id @default(autoincrement())
  walletAddress    String     @unique
  totalScore       Int        @default(0)
  lessonsCompleted Int        @default(0)
  lastSignedDay    String? // UTC day a completion signature was issued
  lastSignedStake  Int? // stakedAt that signature was bound to
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  progress         Progress[]
  levelTests       LevelTest[]
  // Practice map
  practiceLevel    Int        @default(0) // highest completed level
  energy           Int        @default(10)
  energyUpdatedAt  DateTime   @default(now())
  practiceStars    PracticeStar[]
}

model PracticeStar {
  id     Int  @id @default(autoincrement())
  userId Int
  level  Int
  stars  Int
  user   User @relation(fields: [userId], references: [id])

  @@unique([userId, level])
}

model EnergyPurchase {
  txHash    String   @id
  address   String
  energy    Int
  createdAt DateTime @default(now())
}

model DuelResult {
  matchId   String   @id
  p1        String
  p2        String
  winner    String? // null = draw / cancelled
  scoreP1   Int
  scoreP2   Int
  txHash    String?
  vsBot     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model LevelTest {
  id        Int      @id @default(autoincrement())
  userId    Int
  correct   Int
  level     Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Progress {
  id        Int      @id @default(autoincrement())
  userId    Int
  lessonId  Int
  score     Int
  day       String // YYYY-MM-DD (UTC)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId, day])
}
