PORT=5000
DATABASE_URL=file:./dev.db
# Comma separated, * = allow all
CORS_ORIGIN=*
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Private key whose address is the contract's `verifier` (signs lesson completions)
VERIFIER_PRIVATE_KEY=0x...
# Optional override; defaults to src/contract/moningo.json written by the deploy script
MONINGO_ADDRESS=
