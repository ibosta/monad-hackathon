{
  "name": "moningo-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "prisma db push --skip-generate && node src/index.js",
    "dev": "prisma db push && node --watch src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.js\" \"*.json\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "viem": "^2.56.9",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "prisma": "^6.19.3"
  }
}
