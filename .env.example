# Shared by docker compose (backend + deployer). Copy to .env and fill in.

# Deployer wallet - fund it at https://faucet.monad.xyz or blitz.devnads.com
PRIVATE_KEY=0x...
# Backend signer. Its address must be the contract's verifier.
# Easiest: use the same key as PRIVATE_KEY (deploy sets verifier = deployer by default).
VERIFIER_PRIVATE_KEY=0x...
VERIFIER_ADDRESS=
POOL_SEED_MON=0.5
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CORS_ORIGIN=*
