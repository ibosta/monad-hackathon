# Backend API base URL (Express server, see backend/src/index.js)
# Defaults to http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Monad Testnet RPC (matches backend MONAD_RPC_URL default)
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Optional explicit Moningo contract address override.
# If unset, the frontend falls back to the address provided by GET /api/config
# from the backend (which reads backend/src/contract/moningo.json).
NEXT_PUBLIC_MONINGO_CONTRACT_ADDRESS=
